      "delete_workflow_instance": false,
      "description": "This workflow moves a Meraki network from one organization to another. \n\n**Notes**\n- Ensure that Early API Access is enabled for the source and destination organizations, which can be found under Organization \u003e Early Access.\n- Create a Meraki Target, if one doesn't already exist.\n- If moving Networks to orgs on other shards is required, reach out to the Cisco Networking Product Team to be included in the beta.\n\n*Currently both organizations must exist on the same shard (nXXX.meraki.com). Network moves between shards is in private beta.*",
      "display_name": "Meraki - Move Network Between Organizations",
      "runtime_user": {
        "override_target_runtime_user": false,
        "specify_on_workflow_start": false,
        "target_default": true
      },
      "target": {
        "target_type": "meraki.endpoint",
        "specify_on_workflow_start": true
      }
